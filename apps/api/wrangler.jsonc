{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questionbank-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Required by Better Auth (AsyncLocalStorage) and node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // The public site (the web worker, which proxies /api/* here). Auth runs on this
    // origin and trusts only it, and its domain goes in the watermark on public PDFs.
    // CI sets the deployed value at deploy time (`--var SITE_URL:…`).
    "SITE_URL": "http://localhost:5173",
    // AI analysis of uploads: PDFs are compressed (only to cut Gemini's input cost),
    // then read by Gemini. Published papers are watermarked by the same PDF processor.
    // Keys are the GEMINI_API_KEY and COMPRESSOR_API_KEY secrets.
    "PDF_PROCESSOR_URL": "https://pdf-processor.diuqbank.com",
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questionbank",
      // Production. Local dev and tests use a local copy, whatever the id.
      "database_id": "ad50a07f-3aed-4006-9974-78df2b9bcfc6",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "questionbank-papers",
    },
  ],
  // Background work with retries, run by the API's own queue handler:
  // - uploads are analysed (compress → Gemini);
  // - published papers get a watermarked copy, the public download (PDF processor).
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "qb-submission-analysis" },
      { "binding": "WATERMARK_QUEUE", "queue": "qb-pdf-watermark" },
    ],
    "consumers": [
      {
        "queue": "qb-submission-analysis",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 30,
      },
      {
        "queue": "qb-pdf-watermark",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  // The top level is production (and local dev). `staging` is deployed from the dev
  // branch as questionbank-api-staging, with its own database, bucket and queues.
  // Bindings and vars aren't inherited, so every one is repeated here.
  "env": {
    "staging": {
      "vars": {
        "SITE_URL": "http://localhost:5173",
        "PDF_PROCESSOR_URL": "https://pdf-processor.diuqbank.com",
        "GEMINI_MODEL": "gemini-3.8-flash",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "questionbank-staging",
          "database_id": "3f71cc27-97ef-409a-8e8f-65aecdfc3fc7",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "questionbank-papers-staging",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "ANALYSIS_QUEUE",
            "queue": "qb-submission-analysis-staging",
          },
          { "binding": "WATERMARK_QUEUE", "queue": "qb-pdf-watermark-staging" },
        ],
        "consumers": [
          {
            "queue": "qb-submission-analysis-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "retry_delay": 30,
          },
          {
            "queue": "qb-pdf-watermark-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "retry_delay": 30,
          },
        ],
      },
    },
  },
}
