{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questionbank-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Required by Better Auth (AsyncLocalStorage) and node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Public origin that serves /api/auth/* (the web worker proxies it in the browser).
    "BETTER_AUTH_URL": "http://localhost:5173",
    // Comma-separated origins allowed to call auth endpoints.
    "TRUSTED_ORIGINS": "http://localhost:5173",
    // AI analysis of uploads: PDFs are compressed (only to cut Gemini's input cost),
    // then read by Gemini. Keys are the GEMINI_API_KEY and COMPRESSOR_API_KEY secrets.
    "PDF_PROCESSOR_URL": "https://pdf-processor.diuqbank.com",
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questionbank",
      // Local-only placeholder. Replace with the real id from `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "questionbank-papers",
    },
  ],
  // Uploads are analysed in the background: the API enqueues, its queue handler runs
  // the analysis (compress → Gemini) with retries.
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "qb-submission-analysis" },
    ],
    "consumers": [
      {
        "queue": "qb-submission-analysis",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
}
