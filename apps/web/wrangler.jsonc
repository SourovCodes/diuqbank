{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questionbank-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "services": [
    {
      // Zero-hop calls to the API worker. Locally this resolves to the `wrangler dev`
      // session of apps/api via the dev registry, so run both (`pnpm dev` at the root).
      "binding": "API",
      "service": "questionbank-api",
    },
  ],
  // Deployed from the dev branch as questionbank-web-staging (build with
  // CLOUDFLARE_ENV=staging). Service bindings aren't inherited.
  "env": {
    "staging": {
      "services": [{ "binding": "API", "service": "questionbank-api-staging" }],
    },
  },
}
