{
  "name": "questionbank",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @qb/api --filter @qb/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @qb/web test:e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @qb/api db:generate",
    "db:migrate": "pnpm --filter @qb/api db:migrate:local",
    "db:seed": "pnpm --filter @qb/api db:seed:local",
    "import-legacy": "pnpm --filter @qb/api import-legacy",
    "make-admin": "pnpm --filter @qb/api make-admin"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
